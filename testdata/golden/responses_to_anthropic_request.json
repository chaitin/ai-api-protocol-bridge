{
  "max_tokens": 4096,
  "messages": [
    {
      "content": [
        {
          "text": "List the files in the working directory.",
          "type": "text"
        }
      ],
      "role": "user"
    }
  ],
  "model": "upstream-model",
  "stream": true,
  "system": [
    {
      "cache_control": {
        "type": "ephemeral"
      },
      "text": "You are a coding agent running in a sandbox. Follow the user's request.",
      "type": "text"
    }
  ],
  "thinking": {
    "budget_tokens": 2048,
    "type": "enabled"
  },
  "tool_choice": {
    "disable_parallel_tool_use": true,
    "type": "auto"
  },
  "tools": [
    {
      "description": "Run a shell command.",
      "input_schema": {
        "properties": {
          "command": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "name": "shell",
      "strict": false
    }
  ]
}
