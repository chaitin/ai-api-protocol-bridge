{
  "input": [
    {
      "content": [
        {
          "text": "List the files in the working directory.",
          "type": "input_text"
        }
      ],
      "role": "user",
      "type": "message"
    }
  ],
  "instructions": "You are a coding agent running in a sandbox.\u003cenv\u003e\nWorking directory: /workspace\nPlatform: linux\n\u003c/env\u003e",
